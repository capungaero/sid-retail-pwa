VITE_API_URL=https://sid.4dm1n.my.id/api
VITE_STORE_NAME=SID Retail
# No print bridge service exists/runs anywhere in this deployment - leaving this set to a
# nonexistent local address made every "Cetak" click silently fail (fetch to 127.0.0.1:18181
# gets refused, caught, and swallowed) instead of falling through to the browser's OS print
# dialog via iframe.contentWindow.print(), which is what actually works with a printer whose
# driver is already installed on the cashier's PC. Leave this unset unless a real bridge is
# built and running.
