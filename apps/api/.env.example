APP_NAME="SID Retail API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sid_retail
DB_USERNAME=sid_app
DB_PASSWORD=change-this

# Dedicated read-only credential for SettingsBackupController's mysqldump — never sid_app, never
# root, and not the sid_migrator DDL account either. Grants: SELECT, LOCK TABLES, SHOW VIEW,
# TRIGGER, EVENT on sid_retail.* only (what `mysqldump --single-transaction --quick` needs).
BACKUP_DB_USERNAME=sid_backup
BACKUP_DB_PASSWORD=change-this
CACHE_STORE=database
SESSION_DRIVER=database
